# ==============================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE - F1 DATA PIPELINE (.env.example)
# Renomeie este arquivo para .env na raiz do projeto e preencha com seus dados.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE CLOUD STORAGE & BIGQUERY - DATA LAKE & DATA WAREHOUSE
# ------------------------------------------------------------------------------
# ID do projeto no Google Cloud Platform
GCP_PROJECT_ID=f1-analytics-platform

# Nome do bucket GCS criado para armazenar os arquivos Parquet brutos
BUCKET_NAME=f1-lake-storage

# Caminho para o arquivo de credenciais JSON da Service Account
GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL - SERVING LAYER (WEBSITE MARTS INDEXADOS)
# ------------------------------------------------------------------------------
# São duas conexões com propostas distintas (mesmo banco, portas diferentes do pooler):
#
# a) PIPELINE (escrita) -> Session Pooler, porta 5432
#    Usada pelo sync_serving_layer.py: sessão dedicada, necessária para COPY, DDL e troca atômica de tabelas.
POSTGRES_CONNECTION_URL=postgresql://postgres.your-project-ref:your_password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# b) SITE (leitura) -> Transaction Pooler, porta 6543
#    Usada pelo Next.js: conexões multiplexadas, ideais para muitas leituras curtas em ambiente serverless (Vercel).
#    Opcional: se omitida, o site deriva a URL trocando 5432 por 6543 em POSTGRES_CONNECTION_URL.
POSTGRES_WEB_URL=postgresql://postgres.your-project-ref:your_password@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. APACHE AIRFLOW CONFIGURATION
# ------------------------------------------------------------------------------
# UID do usuário do host para evitar problemas de permissão nos volumes mapeados
# Em Linux/macOS, use o comando `id -u` (geralmente 1000 ou 50000). Em Windows/WSL2, 50000 funciona como padrão.
AIRFLOW_UID=50000

# ------------------------------------------------------------------------------
# 4. FORMULA 1 ACCOUNT (FASTF1 LIVETIMING AUTHENTICATION)
# ------------------------------------------------------------------------------
# Credenciais de conta gratuita em https://www.formula1.com para acesso às voltas/telemetria da temporada atual
F1_USERNAME=
F1_PASSWORD=
