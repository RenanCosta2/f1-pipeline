# ==============================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# Renomeie este arquivo para .env e preencha as variáveis antes de executar.
# ==============================================================================

# SUPABASE CONFIGURATIONS
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# POSTGRESQL / SUPABASE DATABASE CONNECTION
DB_HOST=your_db_host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password

# FASTF1 API / EXTRACTION CONFIGURATIONS
# (Caso precise de tokens, diretórios de cache locais ou filtros específicos)
FASTF1_CACHE_DIR=./ingestion/cache
